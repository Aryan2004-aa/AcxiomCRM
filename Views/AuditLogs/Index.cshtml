@model PagedList<AuditLog>
@{ ViewData["Title"] = "Audit Log"; }
<h3 class="mb-3">Audit Log</h3>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-2"><input name="user" value="@ViewBag.User" class="form-control" placeholder="User" /></div>
    <div class="col-md-2"><select name="module" asp-items="(SelectList)ViewBag.Modules" class="form-select"><option value="">All modules</option></select></div>
    <div class="col-md-2"><select name="action" asp-items="(SelectList)ViewBag.Actions" class="form-select"><option value="">All actions</option></select></div>
    <div class="col-md-2"><input type="date" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="table-responsive card"><table class="table table-sm table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Time</th><th>User</th><th>Action</th><th>Module</th><th>Record</th><th>Result</th><th>IP</th><th>Details</th></tr></thead><tbody>
    @foreach (var a in Model.Items)
    {
        <tr><td class="text-nowrap">@a.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</td><td>@a.UserName</td><td>@a.Action</td><td>@a.EntityName</td><td>@a.RecordId</td>
            <td><span class="badge @(a.Result == "Success" ? "bg-success" : "bg-danger")">@a.Result</span></td><td>@a.IpAddress</td>
            <td>@if (!string.IsNullOrEmpty(a.OldValue) || !string.IsNullOrEmpty(a.NewValue))
                { <details><summary>view</summary><div class="small"><b>Old:</b> <code>@a.OldValue</code><br /><b>New:</b> <code>@a.NewValue</code></div></details> }</td></tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No audit records found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
