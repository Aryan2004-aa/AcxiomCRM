<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> AcxiomCRM</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
        @if (User.Identity.IsAuthenticated)
        {
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Opportunities</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Index">All Opportunities</a></li>
                        <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Pipeline">Sales Pipeline</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Follow-Ups</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Index">All Follow-Ups</a></li>
                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Pending">Pending Follow-Ups</a></li>
                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create">Schedule Follow-Up</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                @if (User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Administration</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Roles">Roles</a></li>
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Permissions">Permissions</a></li>
                            <li><a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index">Audit Log</a></li>
                        </ul>
                    </li>
                }
            </ul>
            <form class="d-flex align-items-center gap-2" asp-controller="Account" asp-action="Logout" method="post">
                <span class="navbar-text text-light small"><i class="bi bi-person-circle"></i> @User.Identity.Name
                    <span class="badge bg-secondary">@(User.IsInRole(Roles.Admin) ? "Admin" : User.IsInRole(Roles.Manager) ? "Manager" : "Sales Executive")</span></span>
                <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
            </form>
        }
        else
        {
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
            </ul>
        }
        </div>
    </div>
</nav>

<main class="container-fluid py-4 px-lg-4">
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>

<footer class="container-fluid text-center pb-4">&copy; @DateTime.Now.Year AcxiomCRM</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
