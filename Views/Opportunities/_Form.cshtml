@model Opportunity
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control" /><span asp-validation-for="OpportunityName" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="(SelectList)ViewBag.Customers" class="form-select"><option value="0">-- Select --</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" asp-items="(SelectList)ViewBag.Leads" class="form-select"><option value="">-- None --</option></select></div>
    <div class="col-md-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" type="number" min="0" max="100" /><span asp-validation-for="Probability" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Source" class="form-label"></label><input asp-for="Source" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="AssignedTo" class="form-label"></label><select asp-for="AssignedTo" asp-items="(SelectList)ViewBag.Users" class="form-select"></select><span asp-validation-for="AssignedTo" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div>
