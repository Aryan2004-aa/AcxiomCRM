@model Opportunity
@{ ViewData["Title"] = "Edit Opportunity"; }
<h3>Edit Opportunity</h3>
<form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post" class="card card-body"><partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.OpportunityId">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
