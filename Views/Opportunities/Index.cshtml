@model PagedList<Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="d-flex justify-content-between mb-3"><h3>Opportunities</h3>
    <div><a class="btn btn-outline-secondary" asp-action="Pipeline">Sales Pipeline</a> <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Opportunity</a></div></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Opportunity name" /></div>
    <div class="col-md-3"><select name="customerId" asp-items="(SelectList)ViewBag.Customers" class="form-select"><option value="">All customers</option></select></div>
    <div class="col-md-2"><select name="stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" class="form-select"><option value="">All stages</option></select></div>
    <div class="col-md-2"><select name="status" class="form-select"><option value="">All status</option><option>Open</option><option>Won</option><option>Lost</option></select></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Search</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Status</th><th>Amount</th><th>Prob.</th><th>Weighted</th><th>Close date</th><th>Owner</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model.Items)
    {
        <tr><td>@o.OpportunityName</td><td>@o.Customer?.CustomerName</td><td><span class="badge bg-primary">@o.Stage</span></td><td>@o.Status</td>
            <td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td>₹@o.Weighted.ToString("N0")</td><td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td><td>@o.AssignedUser?.FullName</td>
            <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@o.OpportunityId">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@o.OpportunityId">Edit</a>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                { <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete this opportunity?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form> }</td></tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">No opportunities found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
