@model Opportunity
@{ ViewData["Title"] = Model.OpportunityName; }
<div class="d-flex justify-content-between mb-3"><h3>@Model.OpportunityName <span class="badge bg-primary fs-6">@Model.Stage</span></h3>
    <div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.OpportunityId">Edit</a> <a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<div class="card card-body mb-3"><dl class="row mb-0">
    <dt class="col-sm-2">Customer</dt><dd class="col-sm-4"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.CustomerName</a></dd>
    <dt class="col-sm-2">Lead</dt><dd class="col-sm-4">@Model.Lead?.LeadName</dd>
    <dt class="col-sm-2">Amount</dt><dd class="col-sm-4">₹@Model.Amount.ToString("N2")</dd>
    <dt class="col-sm-2">Probability</dt><dd class="col-sm-4">@Model.Probability%</dd>
    <dt class="col-sm-2">Weighted</dt><dd class="col-sm-4">₹@Model.Weighted.ToString("N2")</dd>
    <dt class="col-sm-2">Expected Close</dt><dd class="col-sm-4">@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-2">Status</dt><dd class="col-sm-4">@Model.Status</dd>
    <dt class="col-sm-2">Owner</dt><dd class="col-sm-4">@Model.AssignedUser?.FullName</dd>
    <dt class="col-sm-2">Notes</dt><dd class="col-sm-10">@Model.Notes</dd></dl></div>
<div class="card"><div class="card-header d-flex justify-content-between">Follow-Ups <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId">+ add</a></div>
    <ul class="list-group list-group-flush">@foreach (FollowUp f in ViewBag.FollowUps) { <li class="list-group-item">@f.FollowUpDate.ToString("dd MMM yyyy") — @f.Subject <span class="badge bg-secondary">@f.Status</span></li> }</ul></div>
