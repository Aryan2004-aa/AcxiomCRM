@model Lead
@{ ViewData["Title"] = "Edit Lead"; }
<h3>Edit Lead <small class="text-muted">@Model.LeadCode</small></h3>
<form asp-action="Edit" asp-route-id="@Model.LeadId" method="post" class="card card-body"><partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.LeadId">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
