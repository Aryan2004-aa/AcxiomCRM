@model PagedList<Lead>
@{ ViewData["Title"] = "Leads"; }
<div class="d-flex justify-content-between mb-3"><h3>Leads</h3><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Lead</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Lead name or company" /></div>
    <div class="col-md-2"><select name="status" asp-items="Html.GetEnumSelectList<LeadStatus>()" class="form-select"><option value="">All statuses</option></select></div>
    <div class="col-md-3"><select name="assignedTo" asp-items="(SelectList)ViewBag.FilterUsers" class="form-select"><option value="">All users</option></select></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Search</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Code</th><th>Lead</th><th>Company</th><th>Source</th><th>Status</th><th>Priority</th><th>Value</th><th>Assigned</th><th></th></tr></thead>
    <tbody>
    @foreach (var l in Model.Items)
    {
        <tr><td>@l.LeadCode</td><td>@l.LeadName</td><td>@l.CompanyName</td><td>@l.Source</td><td><span class="badge bg-primary">@l.Status</span></td><td>@l.Priority</td>
            <td>₹@l.ExpectedValue.ToString("N0")</td><td>@l.AssignedUser?.FullName</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@l.LeadId">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@l.LeadId">Edit</a>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                { <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline" onsubmit="return confirm('Delete this lead permanently?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form> }
            </td></tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">No leads found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
