@model Lead
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control" /><span asp-validation-for="LeadName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" maxlength="10" inputmode="numeric" /><span asp-validation-for="Phone" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" asp-items="@(new SelectList(Lead.Sources, Model.Source))" class="form-select"><option value="">-- Select --</option></select><span asp-validation-for="Source" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<LeadPriority>()" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" max="100000000" /><span asp-validation-for="ExpectedValue" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="AssignedTo" class="form-label"></label><select asp-for="AssignedTo" asp-items="(SelectList)ViewBag.Users" class="form-select"></select><span asp-validation-for="AssignedTo" class="text-danger"></span></div>
    @if (Model.LeadId != 0)
    {
        <div class="col-md-3"><label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="@(new SelectList((IEnumerable<LeadStatus>)ViewBag.StatusOptions, Model.Status))" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
    }
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div>
