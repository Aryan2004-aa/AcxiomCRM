@model ResetPasswordVm
@{ ViewData["Title"] = "Reset Password"; }
<h3>Reset password for @Model.Email</h3>
<form asp-action="ResetPassword" method="post" class="card card-body" style="max-width:520px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
    <div><button class="btn btn-primary">Reset</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
