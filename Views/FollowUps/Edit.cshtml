@model FollowUp
@{ ViewData["Title"] = "Edit Follow-Up"; }
<h3>Edit Follow-Up</h3>
<form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post" class="card card-body"><partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
