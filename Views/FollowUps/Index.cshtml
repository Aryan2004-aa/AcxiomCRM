@model PagedList<FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }
<div class="d-flex justify-content-between mb-3"><h3>Follow-Ups</h3><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Schedule</a></div>
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-2"><input type="date" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><select name="status" asp-items="Html.GetEnumSelectList<FollowUpStatus>()" class="form-select"><option value="">All statuses</option></select></div>
    <div class="col-md-2"><select name="assignedTo" asp-items="(SelectList)ViewBag.FilterUsers" class="form-select"><option value="">All users</option></select></div>
    <div class="col-md-2"><select name="customerId" asp-items="(SelectList)ViewBag.Customers" class="form-select"><option value="">Any customer</option></select></div>
    <div class="col-md-2"><select name="leadId" asp-items="(SelectList)ViewBag.Leads" class="form-select"><option value="">Any lead</option></select></div>
    <div class="col-md-2"><div class="form-check"><input type="checkbox" class="form-check-input" name="overdue" value="true" id="od" @(((bool)ViewBag.Overdue) ? "checked" : "") /><label for="od" class="form-check-label">Overdue only</label></div></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Date</th><th>Subject</th><th>Related to</th><th>Type</th><th>Status</th><th>Assigned</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model.Items)
    {
        <tr class="@(f.IsOverdue ? "table-danger" : "")">
            <td>@f.FollowUpDate.ToString("dd MMM yyyy") @if (f.IsOverdue) { <span class="badge bg-danger">Overdue</span> }</td>
            <td>@f.Subject</td><td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? f.Opportunity?.OpportunityName)</td><td>@f.FollowUpType</td><td>@f.Status</td><td>@f.AssignedUser?.FullName</td>
            <td class="text-end text-nowrap">
                @if (f.Status == FollowUpStatus.Planned)
                {
                    <form asp-action="SetStatus" asp-route-id="@f.FollowUpId" asp-route-status="Completed" method="post" class="d-inline"><button class="btn btn-sm btn-success">Complete</button></form>
                    <form asp-action="SetStatus" asp-route-id="@f.FollowUpId" asp-route-status="Missed" method="post" class="d-inline"><button class="btn btn-sm btn-warning">Missed</button></form>
                    <form asp-action="SetStatus" asp-route-id="@f.FollowUpId" asp-route-status="Cancelled" method="post" class="d-inline" onsubmit="return confirm('Cancel this follow-up?');"><button class="btn btn-sm btn-outline-danger">Cancel</button></form>
                }
                <form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post" class="d-inline-flex gap-1">
                    <input type="date" name="newDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:140px" required /><button class="btn btn-sm btn-outline-secondary">Reschedule</button></form>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@f.FollowUpId">Edit</a>
            </td></tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No follow-ups found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
