@model Customer
@{ ViewData["Title"] = "Edit Customer"; }
<h3>Edit Customer <small class="text-muted">@Model.CustomerCode</small></h3>
<form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post" class="card card-body">
    <partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
