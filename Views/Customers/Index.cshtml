@model PagedList<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between mb-3"><h3>Customers</h3><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Customer</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name, email, phone, company" /></div>
    <div class="col-md-3"><select name="status" asp-items="Html.GetEnumSelectList<CustomerStatus>()" class="form-select"><option value="">All statuses</option></select></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Search</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Code</th><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th>Assigned To</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@c.CustomerCode</td><td>@c.CustomerName</td><td>@c.CompanyName</td><td>@c.Email</td><td>@c.Phone</td>
            <td><span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : c.Status == CustomerStatus.Inactive ? "bg-secondary" : "bg-info")">@c.Status</span></td>
            <td>@c.AssignedUser?.FullName</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.CustomerId">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                {
                    if (c.IsActive)
                    {
                        <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this customer?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                    }
                }
            </td>
        </tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No customers found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
