@model Customer
@{ ViewData["Title"] = Model.CustomerName; }
<div class="d-flex justify-content-between mb-3">
    <h3>@Model.CustomerName <small class="text-muted">@Model.CustomerCode</small></h3>
    <div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a>
         <a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
</div>
<div class="card card-body mb-3"><dl class="row mb-0">
    <dt class="col-sm-2">Email</dt><dd class="col-sm-4">@Model.Email</dd>
    <dt class="col-sm-2">Phone</dt><dd class="col-sm-4">@Model.Phone</dd>
    <dt class="col-sm-2">Company</dt><dd class="col-sm-4">@Model.CompanyName</dd>
    <dt class="col-sm-2">Status</dt><dd class="col-sm-4">@Model.Status</dd>
    <dt class="col-sm-2">Address</dt><dd class="col-sm-4">@Model.Address, @Model.City, @Model.State</dd>
    <dt class="col-sm-2">Assigned To</dt><dd class="col-sm-4">@Model.AssignedUser?.FullName</dd>
    <dt class="col-sm-2">Created</dt><dd class="col-sm-4">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-2">Modified</dt><dd class="col-sm-4">@Model.ModifiedDate?.ToString("dd MMM yyyy HH:mm")</dd>
    <dt class="col-sm-2">Notes</dt><dd class="col-sm-10">@Model.Notes</dd>
</dl></div>
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-header d-flex justify-content-between">Opportunities <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId">+ add</a></div>
        <ul class="list-group list-group-flush">
        @foreach (Opportunity o in ViewBag.Opps) { <li class="list-group-item"><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a> — @o.Stage — ₹@o.Amount.ToString("N0")</li> }
        </ul></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-header d-flex justify-content-between">Follow-Ups <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId">+ add</a></div>
        <ul class="list-group list-group-flush">
        @foreach (FollowUp f in ViewBag.FollowUps) { <li class="list-group-item">@f.FollowUpDate.ToString("dd MMM yyyy") — @f.Subject <span class="badge bg-secondary">@f.Status</span></li> }
        </ul></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-header d-flex justify-content-between">Activities <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId">+ add</a></div>
        <ul class="list-group list-group-flush">
        @foreach (Activity a in ViewBag.Activities) { <li class="list-group-item">@a.ActivityDate.ToString("dd MMM yyyy") — @a.ActivityType: @a.Subject</li> }
        </ul></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-header">Change History</div>
        <ul class="list-group list-group-flush">
        @foreach (AuditLog a in ViewBag.History) { <li class="list-group-item small">@a.CreatedDate.ToString("dd MMM yyyy HH:mm") — <b>@a.Action</b> by @a.UserName</li> }
        </ul></div></div>
</div>
