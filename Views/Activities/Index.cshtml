@model PagedList<Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between mb-3"><h3>Activities</h3><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Log Activity</a></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-2"><select name="type" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select"><option value="">All types</option></select></div>
    <div class="col-md-2"><select name="status" asp-items="Html.GetEnumSelectList<ActivityStatus>()" class="form-select"><option value="">All statuses</option></select></div>
    <div class="col-md-2"><input type="date" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><select name="assignedTo" asp-items="(SelectList)ViewBag.FilterUsers" class="form-select"><option value="">All users</option></select></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="table-responsive card"><table class="table table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related</th><th>Status</th><th>Assigned</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.Items)
    {
        <tr><td>@a.ActivityDate.ToString("dd MMM yyyy")</td><td>@a.ActivityType</td><td>@a.Subject</td><td>@(a.Customer?.CustomerName ?? a.Lead?.LeadName)</td><td>@a.Status</td><td>@a.AssignedUser?.FullName</td>
            <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.ActivityId">Edit</a>
                <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
    }
    @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No activities found.</td></tr> }
    </tbody></table></div>
<div class="mt-3"><partial name="_Pager" model="Model" /></div>
