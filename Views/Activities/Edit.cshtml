@model Activity
@{ ViewData["Title"] = "Edit Activity"; }
<h3>Edit Activity</h3>
<form asp-action="Edit" asp-route-id="@Model.ActivityId" method="post" class="card card-body"><partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
